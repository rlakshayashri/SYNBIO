APP_NAME=SynDataX
APP_ENV=development
LOG_LEVEL=INFO
# Primary Database (Recommended / Production): PostgreSQL 16
DATABASE_URL=postgresql+psycopg://syndatax:syndatax@localhost:5432/syndatax

# Optional Local Development Fallback: SQLite
# DATABASE_URL=sqlite:///./syndatax.db
MAX_UPLOAD_SIZE_MB=50
DATASET_STORAGE_PATH=storage/datasets
